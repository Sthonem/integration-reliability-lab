# Create .env from this file with fresh random secrets:
#   python -m irlab.devtools init-env
# Never commit .env. All data in this project is synthetic.

# Local runs: SQLite. Docker Compose overrides this with PostgreSQL (docker-compose.yml).
DATABASE_URL=sqlite+aiosqlite:///./irlab.db
DB_AUTO_CREATE=true
# Empty = in-process memory idempotency store (single process only). Compose uses Redis.
REDIS_URL=

# Webhook signing secrets, one list per source. Comma-separated: every entry
# verifies (rotation window); the first entry is the current one, which the
# mock providers sign with. Empty = source rejected (fail closed).
POS_WEBHOOK_SECRETS=__generate__
PAYMENTS_WEBHOOK_SECRETS=__generate__
LOYALTY_WEBHOOK_SECRETS=__generate__

# Operator writes (replay, discard, reconcile, worker tick) need header X-Ops-Key.
# Empty = those endpoints answer 503 (fail closed).
OPS_API_KEY=__generate__

# PostgreSQL password for Docker Compose (user irlab, databases irlab and irlab_test).
POSTGRES_PASSWORD=__generate__

WEBHOOK_TOLERANCE_S=300
WEBHOOK_MAX_BODY_BYTES=262144
IDEMPOTENCY_LOCK_TTL_S=30
IDEMPOTENCY_DONE_TTL_S=259200

# Mount the three mock providers under /mock/{pos,payments,loyalty} in the hub process
# and run the worker loop in the API process (local runs). Compose turns both off.
MOUNT_MOCKS=true
RUN_WORKER=true
LOG_LEVEL=INFO
# json | kv
LOG_FORMAT=kv

# Worker and outbound calls (production-like defaults; Compose shortens some for the lab)
PARK_TIMEOUT_S=300
OUTBOUND_TIMEOUT_S=2
RETRY_BASE_S=0.5
RETRY_CAP_S=60
RETRY_MAX_ATTEMPTS=6
RECONCILE_INTERVAL_S=60
RECONCILE_GRACE_S=30
RECONCILE_AUTO_REPAIR=true

# Alerts: optional webhook sink (chat / on-call tool). Empty = log sink only.
ALERT_WEBHOOK_URL=

# Read-only AI triage: mock (default, offline) or anthropic (pip install -e ".[ai]").
TRIAGE_PROVIDER=mock
# ANTHROPIC_API_KEY=
# TRIAGE_MODEL=claude-opus-5-5

# Standalone mock processes (irlab.mocks.serve) read MOCK_<NAME>_WEBHOOK_URL and sign
# with MOCK_<NAME>_WEBHOOK_SECRET, or by default the first <NAME>_WEBHOOK_SECRETS entry.
# MOCK_POS_WEBHOOK_URL=http://localhost:8000/webhooks/pos
# MOCK_PAYMENTS_WEBHOOK_URL=http://localhost:8000/webhooks/payments
# MOCK_LOYALTY_WEBHOOK_URL=http://localhost:8000/webhooks/loyalty
